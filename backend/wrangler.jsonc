// Top level: local development and tests only (local Miniflare identifiers, never deployed).
// env.staging: the provisioned staging environment with synthetic mail and its own resources (ops/staging.md).
// Production is added later with its own reviewed IDs; staging never binds production storage.
// compatibility_date is the newest date the pinned test runtime (vitest-pool-workers 0.22.0) supports.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "adminifender-local",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-22",
  "workers_dev": false,
  // Local-only relying party values. Production uses the reviewed owner domain and Play signing origin.
  "vars": { "RP_ID": "localhost", "RP_NAME": "Adminifender (local)", "EXPECTED_ORIGINS": "http://localhost:8787" },
  "triggers": { "crons": ["* * * * *"] },
  "d1_databases": [
    {
      "binding": "CONTROL_DB",
      "database_name": "adminifender-control-local",
      "database_id": "local-control",
      "migrations_dir": "migrations/control"
    },
    {
      "binding": "ARCHIVE_0001",
      "database_name": "adminifender-archive-0001-local",
      "database_id": "local-archive-0001",
      "migrations_dir": "migrations/archive"
    }
  ],
  "r2_buckets": [
    { "binding": "ARCHIVE_BUCKET", "bucket_name": "adminifender-archive-local" },
    { "binding": "DELETION_LEDGER", "bucket_name": "adminifender-deletion-ledger-local" }
  ],
  "queues": {
    "producers": [{ "binding": "WORK_QUEUE", "queue": "adminifender-work-local" }],
    "consumers": [
      {
        "queue": "adminifender-work-local",
        "max_batch_size": 10,
        "max_retries": 5,
        "dead_letter_queue": "adminifender-dead-local"
      }
    ]
  },
  "env": {
    "staging": {
      "name": "adminifender-staging",
      "workers_dev": false,
      // Served on a digifender.com subdomain; passkeys use the digifender.com root as RP ID. The Android
      // android:apk-key-hash origin is added once the staging signing certificate exists.
      "routes": [{ "pattern": "adminifender-staging.digifender.com", "custom_domain": true }],
      "vars": { "RP_ID": "digifender.com", "RP_NAME": "Adminifender (staging)", "EXPECTED_ORIGINS": "https://adminifender-staging.digifender.com,android:apk-key-hash:-o1rnKJPY5wdBS3AUHeGPt1biuSl6EAiKbs2AnQ-Cbs" },
      // Bound, but the app's defaults keep the paid ceiling at 0 and deny cloud until account headroom is attested.
      "ai": { "binding": "AI" },
      "triggers": { "crons": ["* * * * *"] },
      "d1_databases": [
        {
          "binding": "CONTROL_DB",
          "database_name": "adminifender-control-staging",
          "database_id": "440d5df1-af38-4fb0-8353-07b5b56f9256",
          "migrations_dir": "migrations/control"
        },
        {
          "binding": "ARCHIVE_0001",
          "database_name": "adminifender-archive-0001-staging",
          "database_id": "f66aea31-0fd0-4893-b556-0c0cc878122c",
          "migrations_dir": "migrations/archive"
        }
      ],
      "r2_buckets": [
        { "binding": "ARCHIVE_BUCKET", "bucket_name": "adminifender-archive-staging" },
        { "binding": "DELETION_LEDGER", "bucket_name": "adminifender-deletion-ledger-staging" }
      ],
      "queues": {
        "producers": [{ "binding": "WORK_QUEUE", "queue": "adminifender-work-staging" }],
        "consumers": [
          {
            "queue": "adminifender-work-staging",
            "max_batch_size": 10,
            "max_retries": 5,
            "dead_letter_queue": "adminifender-dead-staging"
          }
        ]
      }
    }
  }
}
