    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.147.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "workerd@1.20260815.1": true,
    "workerd@1.20261001.1": true
  },
  "dependencies": {
    "@simplewebauthn/server": "14.0.3",
