{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "allow": [
      "Bash(git status --short)",
      "Bash(git --no-pager diff --no-ext-diff --no-textconv --stat)"
    ],
    "deny": [
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/.dev.vars)",
      "Read(**/.dev.vars.*)",
      "Read(**/.secrets/**)",
      "Read(**/*.key)",
      "Read(**/*service-account*.json)",
      "Edit(**/.env)",
      "Edit(**/.env.*)",
      "Edit(**/.dev.vars)",
      "Edit(**/.dev.vars.*)",
      "Edit(**/.secrets/**)",
      "Edit(**/*.key)",
      "Edit(**/*service-account*.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(gh *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(./gradlew publish*)",
      "Bash(./gradlew *publish*)"
    ]
  },
  "enableAllProjectMcpServers": false
}
