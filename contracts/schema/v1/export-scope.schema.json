{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adminifender.invalid/schema/v1/export-scope.schema.json",
  "title": "Stored export scope (lld.md#exports)",
  "description": "What an export selects, fixed when the export is created. `admission` is always explicit: `normal` is the ordinary archive, `quarantine` only quarantined mail, `all` both. Quarantine is never implied. `archive` is every source of that admission at the snapshot, `filter` narrows by received time and exact envelope addresses (the same criteria as GET /search), and `sources` lists up to 1,000 explicit source IDs.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "admission"],
      "properties": { "kind": { "const": "archive" }, "admission": { "$ref": "#/$defs/admission" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "admission", "filter"],
      "properties": { "kind": { "const": "filter" }, "admission": { "$ref": "#/$defs/admission" }, "filter": { "$ref": "#/$defs/filter" } }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "admission", "sourceIds"],
      "properties": { "kind": { "const": "sources" }, "admission": { "$ref": "#/$defs/admission" }, "sourceIds": { "$ref": "#/$defs/sourceIds" } }
    }
  ],
  "$defs": {
    "admission": { "enum": ["normal", "quarantine", "all"] },
    "address": { "type": "string", "minLength": 1, "maxLength": 320, "pattern": "^[^A-Z\\s]+$" },
    "filter": {
      "description": "At least one criterion. `from` is inclusive and `to` exclusive, on the received time. Addresses are lower case and match an envelope entry exactly.",
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "from": { "$ref": "common.schema.json#/$defs/timestamp" },
        "to": { "$ref": "common.schema.json#/$defs/timestamp" },
        "sender": { "$ref": "#/$defs/address" },
        "recipient": { "$ref": "#/$defs/address" }
      }
    },
    "sourceIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "uniqueItems": true,
      "items": { "$ref": "common.schema.json#/$defs/uuid" }
    }
  }
}
