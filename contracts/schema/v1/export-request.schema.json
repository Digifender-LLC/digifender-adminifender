{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adminifender.invalid/schema/v1/export-request.schema.json",
  "title": "POST /exports body (lld.md#exports)",
  "description": "An omitted scope, or an omitted admission, means the ordinary archive without quarantine. The Worker answers with the fully explicit scope. The Idempotency-Key is bound to the normalized scope, so the same key with a different scope is a 409 idempotency_conflict.",
  "type": "object",
  "additionalProperties": false,
  "properties": { "scope": { "$ref": "#/$defs/scope" } },
  "$defs": {
    "admission": { "$ref": "export-scope.schema.json#/$defs/admission" },
    "scope": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "archive" }, "admission": { "$ref": "#/$defs/admission" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "filter"],
          "properties": { "kind": { "const": "filter" }, "admission": { "$ref": "#/$defs/admission" }, "filter": { "$ref": "export-scope.schema.json#/$defs/filter" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "sourceIds"],
          "properties": { "kind": { "const": "sources" }, "admission": { "$ref": "#/$defs/admission" }, "sourceIds": { "$ref": "export-scope.schema.json#/$defs/sourceIds" } }
        }
      ]
    }
  }
}
