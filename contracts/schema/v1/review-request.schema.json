{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://adminifender.invalid/schema/v1/review-request.schema.json",
  "title": "POST /reviews body (lld.md#reviewed-actions)",
  "description": "A typed native effect with bounded parameters. External P3 effects arrive with their adapters and are not part of this contract.",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "params"],
      "properties": {
        "effect": { "const": "archive.delete" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["sourceIds"],
          "properties": { "sourceIds": { "type": "array", "minItems": 1, "maxItems": 50, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/uuid" } } }
        }
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["effect", "params"],
      "properties": {
        "effect": { "const": "device.revoke" },
        "params": {
          "type": "object",
          "additionalProperties": false,
          "required": ["deviceId"],
          "properties": { "deviceId": { "$ref": "common.schema.json#/$defs/uuid" } }
        }
      }
    }
  ]
}
